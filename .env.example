APP_NAME=PULS API
APP_ENV=development
LOG_LEVEL=INFO

DB_USER=
DB_PASSWORD=
DB_DSN=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

SESSION_TTL_DAYS=30

RESET_CODE_PEPPER=
RESET_CODE_TTL_MIN_FALLBACK=15
RESET_CODE_MAX_ATTEMPTS=5

MAX_LOGIN_ATTEMPTS_FALLBACK=3
MIN_PASSWORD_LENGTH_FALLBACK=8

SMS_PROVIDER=console

AUDIT_SOURCE=API

# Provisioning runs as a dedicated single-instance worker, not inside the API process.
#   one-shot:  python -m app.scripts.provision_users
#   periodic:  python -m app.scripts.provision_worker
PROVISIONING_INTERVAL_MINUTES=10
PROVISIONING_BATCH_SIZE=100
